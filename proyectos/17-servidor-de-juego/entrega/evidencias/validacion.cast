{"version": 2, "width": 120, "height": 40, "timestamp": 1794292407, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "P17 - codigo, supervision y pruebas"}
[0.018317, "o", "\u001b[2J\u001b[HP17 — Servidor de juego Erlang/OTP\r\nDemostracion de codigo y pruebas\r\n"]
[3.029691, "o", "\r\n== Entorno de ejecucion ==\r\n"]
[3.046347, "o", "PRETTY_NAME=\"Ubuntu 26.04.1 LTS\"\r\nNAME=\"Ubuntu\"\r\n"]
[3.062327, "o", "6.18.54.1-microsoft-standard-WSL2\r\n"]
[3.06423, "o", "\r\n== Entorno Erlang/OTP ==\r\n"]
[3.417723, "o", "OTP 27\r\n"]
[3.834127, "o", "rebar 3.26.0 on Erlang/OTP 27 Erts 15.2.7.4\r\n"]
[3.840885, "o", "\u001b[2J\u001b[H== Estado de una partida: gen_statem ==\r\n"]
[3.843673, "o", "    {ok, jugando, #{\r\n        jugadores => [Jugador1, Jugador2],\r\n        tablero => Tablero,\r\n        turno => Jugador1\r\n    }}.\r\n\r\ncallback_mode() ->\r\n    handle_event_function.\r\n"]
[3.843727, "o", "\r\nhandle_event({call, From}, estado, Estado, Datos) ->\r\n    {keep_state, Datos, [{reply, From, #{estado => Estado, datos => Datos}}]};\r\nhandle_event({call, From}, {mover, Jugador, Posicion}, jugando, Datos) ->\r\n    procesar_movimiento(From, Jugador, Posicion, Datos);\r\nhandle_event({call, From}, {mover, _Jugador, _Posicion}, terminado, _Datos) ->\r\n    {keep_state_and_data, [{reply, From, {error, partida_terminada}}]};\r\nhandle_event(_Tipo, _Evento, _Estado, _Datos) ->\r\n    keep_state_and_data.\r\n\r\nprocesar_movimiento(From, Jugador, Posicion, Datos) ->\r\n    Jugadores = maps:get(jugadores, Datos),\r\n"]
[11.856439, "o", "\u001b[2J\u001b[H== Validacion de turno y posicion ==\r\n"]
[11.870786, "o", "                lists:split(Posicion - 1, Tablero),\r\n            NuevoTablero = Antes ++ [Jugador | Despues],\r\n            case ganador(NuevoTablero, Jugador) of\r\n                true ->\r\n                    NuevosDatos = Datos#{\r\n                        tablero := NuevoTablero,\r\n                        ganador => Jugador\r\n                    },\r\n                    {next_state, terminado, NuevosDatos,\r\n                     [{reply, From, {ok, ganador}}]};\r\n                false ->\r\n                    case lists:member(vacio, NuevoTablero) of\r\n                        false ->\r\n                            NuevosDatos = Datos#{\r\n                                tablero := NuevoTablero,\r\n                                resultado => empate\r\n                            },\r\n                            {next_state, terminado, NuevosDatos,\r\n                             [{reply, From, {ok, empate}}]};\r\n                        true ->\r\n                            [OtroJugador] = lists:delete(Jugador, Jugadores),\r\n                            NuevosDatos = Datos#{\r\n                                tablero := NuevoTablero,\r\n                                turno := OtroJugador\r\n                            },\r\n                            {keep_state, NuevosDatos,\r\n                             [{reply, From, {ok, movimiento_aplicado}}]}\r\n                    end\r\n"]
[19.888177, "o", "\u001b[2J\u001b[H== Supervisor raiz: aislamiento one_for_one ==\r\n"]
[19.900128, "o", "\r\ninit([]) ->\r\n    Hijos = [\r\n        #{\r\n            id => p17_eventos,\r\n            start => {p17_eventos, start_link, []},\r\n            restart => permanent,\r\n            shutdown => 5000,\r\n            type => worker,\r\n            modules => [p17_eventos]\r\n        },\r\n        #{\r\n            id => p17_servidor_de_juego_server,\r\n            start => {p17_servidor_de_juego_server, start_link, []},\r\n            restart => permanent,\r\n            shutdown => 5000,\r\n            type => worker,\r\n            modules => [p17_servidor_de_juego_server]\r\n        },\r\n        #{\r\n            id => p17_partidas_sup,\r\n            start => {p17_partidas_sup, start_link, []},\r\n            restart => permanent,\r\n            shutdown => infinity,\r\n            type => supervisor,\r\n            modules => [p17_partidas_sup]\r\n        },\r\n        #{\r\n            id => p17_matchmaking,\r\n            start => {p17_matchmaking, start_link, []},\r\n            restart => permanent,\r\n            shutdown => 5000,\r\n            type => worker,\r\n            modules => [p17_matchmaking]\r\n        },\r\n        #{\r\n            id => p17_http_server,\r\n            start => {p17_http_server, start_link, []},\r\n            restart => permanent,\r\n            shutdown => 5000,\r\n            type => worker,\r\n            modules => [p17_http_server]\r\n        }\r\n    ],\r\n    {ok, {#{strategy => one_for_one, intensity => 10, period => 60}, Hijos}}.\r\n"]
[27.922467, "o", "\u001b[2J\u001b[H== Partidas dinamicas con reinicio temporary ==\r\n"]
[27.936304, "o", "        Error ->\r\n            Error\r\n    end.\r\n\r\niniciar_partida_con_id(Jugador1, Jugador2) ->\r\n    Id = integer_to_binary(erlang:unique_integer([positive, monotonic])),\r\n    Especificacion = #{\r\n        id => Id,\r\n        start => {p17_partida, start_link, [Jugador1, Jugador2]},\r\n        restart => temporary,\r\n        shutdown => 5000,\r\n        type => worker,\r\n        modules => [p17_partida]\r\n    },\r\n    case supervisor:start_child(?MODULE, Especificacion) of\r\n        {ok, Pid} ->\r\n            ok = p17_eventos:registrar_partida(Id, Pid),\r\n            {ok, Id, Pid};\r\n"]
[35.951083, "o", "\u001b[2J\u001b[H== Rutas HTTP, metricas y WebSocket ==\r\n"]
[35.964242, "o", "init([]) ->\r\n    Rutas = cowboy_router:compile([\r\n        {'_', [\r\n            {\"/\", p17_http_handler, inicio},\r\n            {\"/admin\", p17_http_handler, admin_dashboard},\r\n            {\"/admin-stitch.js\", p17_http_handler, admin_stitch_js},\r\n            {\"/api/admin\", p17_http_handler, admin_api},\r\n"]
[35.964387, "o", "            {\"/api/admin/eventos\", p17_http_handler, admin_events_api},\r\n            {\"/metrics\", p17_http_handler, metrics},\r\n            {\"/ws/juego\", p17_ws_handler, #{}},\r\n            {\"/health\", p17_http_handler, health},\r\n            {\"/api/partidas/:id/movimientos\", p17_http_handler, movimiento},\r\n            {\"/api/partidas/:id\", p17_http_handler, partida},\r\n            {\"/api/partidas\", p17_http_handler, partidas}\r\n        ]}\r\n"]
